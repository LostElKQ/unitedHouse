{
  "name": "unitedhouse",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "certs:reset": "tsx ./scripts/setup-certs.ts --reset",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d db --wait && npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "vite dev",
    "docker:build": "tsx ./scripts/setup-certs.ts --build",
    "docker:down": "docker compose down",
    "docker:up": "tsx ./scripts/setup-certs.ts",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "npm run test:unit -- --run",
    "test:unit": "vitest"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "file-type": "^22.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "auth": "^1.7.15",
    "better-auth": "^1.7.15",
    "dotenv-expand": "^1000.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "playwright": "^1.60.0",
    "postgres": "^4.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "npm",
        "version": "^11",
        "onFail": "download"
      }
    ],
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
